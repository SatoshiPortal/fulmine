      "image": "ghcr.io/arkade-os/arkd@sha256:f723e26a1bff7fa529dc0abd414088f294e43be8916dbb8f081dccd6fcad90b5",
      "volumes": [
        {
          "type": "volume",
          "source": "ark_datadir",
          "target": "/app/data",
          "volume": {}
        }
      ],
      "mem_limit": "384m",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      }
    }
  },
  "volumes": {
    "bitcoin_datadir": {},
    "postgres_datadir": {},
    "nbxplorer_datadir": {},
    "fulcrum_datadir": {},
    "mempool_mariadb": {},
    "mempool_api_datadir": {},

      ],
      "mem_limit": "256m",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      }
    },
    "arkd": {
      "depends_on": {
        "arkd-wallet": {
          "condition": "service_started",
          "required": true
        }
      },
      "environment": {
        "ARKD_BOARDING_EXIT_DELAY": "180",
        "ARKD_CHECKPOINT_EXIT_DELAY": "5",
        "ARKD_DB_TYPE": "sqlite",
        "ARKD_ESPLORA_URL": "http://mempool_api:8999/api/v1",
        "ARKD_EVENT_DB_TYPE": "badger",
        "ARKD_LIVE_STORE_TYPE": "inmemory",
        "ARKD_LOG_LEVEL": "4",
        "ARKD_NO_MACAROONS": "true",
        "ARKD_NO_TLS": "true",
        "ARKD_PUBLIC_UNILATERAL_EXIT_DELAY": "5",
        "ARKD_ROUND_MIN_PARTICIPANTS_COUNT": "1",
        "ARKD_SESSION_DURATION": "10",
        "ARKD_UNILATERAL_EXIT_DELAY": "5",
        "ARKD_UNLOCKER_PASSWORD": "secret",
        "ARKD_UNLOCKER_TYPE": "env",
        "ARKD_VTXO_MIN_AMOUNT": "1",
        "ARKD_VTXO_TREE_EXPIRY": "180",
